#!/usr/bin/env python3

# Copyright (c) 2026 Noxmor

import re
import sys
from pathlib import Path


COMMIT_TYPES = {
    "build",
    "chore",
    "ci",
    "docs",
    "feat",
    "fix",
    "perf",
    "refactor",
    "revert",
    "style",
    "test",
}

HEADER_RE = re.compile(
    rf"^(?P<type>{'|'.join(map(re.escape, COMMIT_TYPES))})"
    r"(?:\((?P<scope>[^()\r\n]+)\))?"
    r"(?P<breaking>!)?"
    r": "
    r"(?P<description>\S.*)$",
    re.IGNORECASE,
)

FOOTER_RE = re.compile(
    r"^(?P<token>BREAKING CHANGE|[A-Za-z0-9-]+)"
    r"(?:: | # )"
    r"(?P<value>.+)$",
)


def error(message):
    print(
        f"error: {message}\n\n"
        f"Expected:\n"
        f"<type>[optional scope][optional !]: <description>\n\n"
        f"[optional body]\n\n"
        f"[optional footer(s)]\n\n"
        f"See https://www.conventionalcommits.org/en/v1.0.0/",
        file=sys.stderr,
    )
    return 1


def validate_header(line):
    match = HEADER_RE.fullmatch(line)

    if not match:
        return error(
            "commit message does not follow the Conventional Commits specification"
        )

    description = match.group("description")

    if not description.strip():
        return error("commit description must not be empty")

    return 0


def is_footer_start(line):
    return FOOTER_RE.fullmatch(line) is not None


def validate_footer_block(lines):
    i = 0

    while i < len(lines):
        line = lines[i]
        match = FOOTER_RE.fullmatch(line)

        if not match:
            return error(f"invalid footer syntax: '{line}'")

        token = match.group("token")

        if token.upper() == "BREAKING CHANGE" and token != "BREAKING CHANGE":
            return error("the BREAKING CHANGE footer token must be uppercase")

        i += 1

        while i < len(lines) and not is_footer_start(lines[i]):
            i += 1

    return 0


def validate_message(message):
    lines = [line for line in message.splitlines() if not line.startswith("#")]

    while lines and not lines[-1].strip():
        lines.pop()

    if not lines:
        return error("commit message is empty")

    result = validate_header(lines[0])
    if result != 0:
        return result

    if len(lines) == 1:
        return 0

    if lines[1].strip():
        return error(
            "body or footers must be separated from the description by one blank line"
        )

    remainder = lines[2:]

    if not remainder:
        return 0

    footer_start = None

    for i, line in enumerate(remainder):
        if is_footer_start(line):
            footer_start = i
            break

    if footer_start is None:
        return 0

    body = remainder[:footer_start]
    footers = remainder[footer_start:]

    if body and body[-1].strip():
        return error("footers must be separated from the body by one blank line")

    return validate_footer_block(footers)


def main():
    message_file = Path(sys.argv[1])

    try:
        message = message_file.read_text(encoding="utf-8")
    except OSError as exc:
        return error(f"could not read commit message: {exc}")

    return validate_message(message)


if __name__ == "__main__":
    sys.exit(main())
