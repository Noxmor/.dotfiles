#!/usr/bin/env python3

# Copyright (c) 2026 Noxmor

import json
import os
import re
import subprocess
import sys
from pathlib import Path

HOOK_DIR = Path(__file__).resolve().parent


def main():
    with open(HOOK_DIR / "conventional-branch-spec.json") as f:
        spec = json.load(f)

        branch = subprocess.check_output(
            ["git", "branch", "--show-current"],
            text=True,
        ).strip()

    spec["trunkBranches"].extend(["dev", "devel"])
    spec["grammar"]["regex"] = spec["grammar"]["regex"].replace(
        "develop",
        "develop|dev|devel",
    )

    if re.fullmatch(spec["grammar"]["regex"], branch):
        sys.exit(0)

    types = ", ".join(f"{t['type']}/" for t in spec["types"])
    print(
        f"error: branch '{branch}' does not follow the Conventional Branch "
        f"specification.\nExpected <type>/<description>, where type is one "
        f"of: {types}.\nSee https://conventionalbranch.org/v1.1.0/spec.json",
        file=sys.stderr,
    )

    sys.exit(1)


if __name__ == "__main__":
    main()
